{
  "name": "claude-code-session-sync",
  "displayName": "Claude Code Sync",
  "description": "Sync Claude Code conversations across machines via your own private GitHub repo — lossless event-by-event merge and full version history.",
  "version": "0.2.5",
  "publisher": "kslabs",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucaskge/claude-code-sync.git"
  },
  "bugs": {
    "url": "https://github.com/lucaskge/claude-code-sync/issues"
  },
  "homepage": "https://github.com/lucaskge/claude-code-sync#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai",
    "sync",
    "backup",
    "sessions",
    "conversations",
    "history",
    "github"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Claude Sync",
      "properties": {
        "claudeSync.githubRepoUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.githubRepoUrl%",
          "order": 0,
          "scope": "application"
        },
        "claudeSync.githubToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.githubToken%",
          "order": 1,
          "scope": "machine",
          "ignoreSync": true
        },
        "claudeSync.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoSync%",
          "order": 2,
          "scope": "application"
        },
        "claudeSync.autoSyncInterval": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "%config.autoSyncInterval%",
          "order": 3,
          "scope": "application"
        },
        "claudeSync.syncOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.syncOnStartup%",
          "order": 4,
          "scope": "application"
        }
      }
    },
    "commands": [
      {
        "command": "claudeSync.configure",
        "title": "%command.configure%",
        "category": "Claude Sync",
        "icon": "$(gear)"
      },
      {
        "command": "claudeSync.changeRepository",
        "title": "%command.changeRepository%",
        "category": "Claude Sync",
        "icon": "$(repo)"
      },
      {
        "command": "claudeSync.switchAccount",
        "title": "%command.switchAccount%",
        "category": "Claude Sync",
        "icon": "$(account)"
      },
      {
        "command": "claudeSync.signOut",
        "title": "%command.signOut%",
        "category": "Claude Sync",
        "icon": "$(sign-out)"
      },
      {
        "command": "claudeSync.fullSync",
        "title": "%command.fullSync%",
        "category": "Claude Sync",
        "icon": "$(sync)"
      },
      {
        "command": "claudeSync.push",
        "title": "%command.push%",
        "category": "Claude Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "claudeSync.pull",
        "title": "%command.pull%",
        "category": "Claude Sync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeSync.selectSessions",
        "title": "%command.selectSessions%",
        "category": "Claude Sync",
        "icon": "$(checklist)"
      },
      {
        "command": "claudeSync.refresh",
        "title": "%command.refresh%",
        "category": "Claude Sync",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSync.toggleAutoSync",
        "title": "%command.toggleAutoSync%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.showLog",
        "title": "%command.showLog%",
        "category": "Claude Sync",
        "icon": "$(output)"
      },
      {
        "command": "claudeSync.pushItem",
        "title": "%command.pushItem%",
        "category": "Claude Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "claudeSync.pullItem",
        "title": "%command.pullItem%",
        "category": "Claude Sync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeSync.syncItem",
        "title": "%command.syncItem%",
        "category": "Claude Sync",
        "icon": "$(sync)"
      },
      {
        "command": "claudeSync.openSession",
        "title": "%command.openSession%",
        "category": "Claude Sync",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeSync.revealProject",
        "title": "%command.revealProject%",
        "category": "Claude Sync",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSync",
          "title": "Claude Sync",
          "icon": "media/claude-sync.svg"
        }
      ]
    },
    "views": {
      "claudeSync": [
        {
          "id": "claudeSync.localView",
          "name": "%view.localView%"
        },
        {
          "id": "claudeSync.remoteView",
          "name": "%view.remoteView%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeSync.remoteView",
        "contents": "%welcome.remoteView%",
        "when": "!claudeSync.configured"
      },
      {
        "view": "claudeSync.localView",
        "contents": "%welcome.localView%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSync.push",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "navigation@1"
        },
        {
          "command": "claudeSync.pull",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "navigation@2"
        },
        {
          "command": "claudeSync.fullSync",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "navigation@3"
        },
        {
          "command": "claudeSync.refresh",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "navigation@4"
        },
        {
          "command": "claudeSync.selectSessions",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@1"
        },
        {
          "command": "claudeSync.configure",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@2"
        },
        {
          "command": "claudeSync.toggleAutoSync",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@6"
        },
        {
          "command": "claudeSync.showLog",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@7"
        },
        {
          "command": "claudeSync.changeRepository",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@3"
        },
        {
          "command": "claudeSync.switchAccount",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@4"
        },
        {
          "command": "claudeSync.signOut",
          "when": "view == claudeSync.localView || view == claudeSync.remoteView",
          "group": "more@5"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSync.pushItem",
          "when": "view == claudeSync.localView && viewItem =~ /^local(Project|Session)/",
          "group": "inline@1"
        },
        {
          "command": "claudeSync.syncItem",
          "when": "view == claudeSync.localView && viewItem =~ /^local(Project|Session)/",
          "group": "inline@2"
        },
        {
          "command": "claudeSync.pullItem",
          "when": "view == claudeSync.remoteView && viewItem =~ /^remote(Project|Session)/",
          "group": "inline@1"
        },
        {
          "command": "claudeSync.syncItem",
          "when": "view == claudeSync.remoteView && viewItem =~ /^remote(Project|Session)/",
          "group": "inline@2"
        },
        {
          "command": "claudeSync.pushItem",
          "when": "view == claudeSync.localView && viewItem =~ /^local(Project|Session)/",
          "group": "1_sync@1"
        },
        {
          "command": "claudeSync.pullItem",
          "when": "viewItem =~ /^(local|remote)(Project|Session)/",
          "group": "1_sync@2"
        },
        {
          "command": "claudeSync.syncItem",
          "when": "viewItem =~ /^(local|remote)(Project|Session)/",
          "group": "1_sync@3"
        },
        {
          "command": "claudeSync.openSession",
          "when": "viewItem =~ /^localSession/",
          "group": "2_open@1"
        },
        {
          "command": "claudeSync.revealProject",
          "when": "viewItem =~ /^localProject/",
          "group": "2_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSync.pushItem",
          "when": "false"
        },
        {
          "command": "claudeSync.pullItem",
          "when": "false"
        },
        {
          "command": "claudeSync.syncItem",
          "when": "false"
        },
        {
          "command": "claudeSync.openSession",
          "when": "false"
        },
        {
          "command": "claudeSync.revealProject",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
